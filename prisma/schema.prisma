// Order management app for 学祭 (festival) stalls.
// Users sign in with Google and get invited into one or more Instances
// (a stall/team's own order-management space). ADMIN_EMAIL manages
// instances (create, activate/deactivate, invite members).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- Auth.js (NextAuth) models -------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts    Account[]
  sessions    Session[]
  memberships InstanceMember[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ------------------------------------------------------------

// Grants admin (instance management) access to a Google account, in
// addition to the ADMIN_EMAIL env var bootstrap admin. See
// src/lib/instance.ts#isAdminEmail.
model AdminInvite {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Instance {
  id        String   @id @default(uuid())
  name      String
  // Shown in the header (e.g. "vpro"). Empty string for the default instance.
  label     String   @default("")
  // 稼働/停止. Members can only sign in to / operate an active instance.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  members  InstanceMember[]
  products Product[]
  orders   Order[]
}

model InstanceMember {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  // The invited Google account email. This is the matching key so an
  // invite works even before that person has ever signed in.
  email      String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([instanceId, email])
}

model Product {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name       String
  // Price in yen. 0 is allowed (used for inspection/検品 items).
  price      Int
  // Path under /uploads (own upload, picked default, or AI-generated).
  imageUrl   String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  orderItems OrderItem[]

  @@index([instanceId])
}

enum PaymentMethod {
  CASH // 現金/金券
  PAYPAY // PayPay
  D_PAYMENT // d払い
}

enum OrderStatus {
  WAITING
  COMPLETED
}

model Order {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  // 客の特徴 (customer description, e.g. "赤い帽子")
  customerNote  String?
  paymentMethod PaymentMethod
  status        OrderStatus   @default(WAITING)
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  items OrderItem[]

  @@index([instanceId, status])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot of the product at order time, so CSV export/history stay
  // correct even if the product is later renamed, repriced, or deleted.
  productName String
  unitPrice   Int
  quantity    Int

  @@index([orderId])
}
