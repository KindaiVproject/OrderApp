// Order management app for 学祭 (festival) stalls.
// Users sign in with Google and get invited into one or more Instances
// (a stall/team's own order-management space). ADMIN_EMAIL manages
// instances (create, activate/deactivate, invite members).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) models -------------------------------------------

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  // Self-chosen name, set by the user on /account. Display priority:
  // InstanceMember.displayName -> User.displayName -> name (Google) -> email.
  displayName     String?
  // Also notify 30 minutes before a shift starts (the start-time
  // notification is always sent). On by default; toggled on /account.
  shiftReminder30 Boolean   @default(true)

  accounts          Account[]
  sessions          Session[]
  memberships       InstanceMember[]
  pushSubscriptions PushSubscription[]
}

// One row per browser/device a user enabled notifications on (Web Push).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ------------------------------------------------------------

// Grants admin (instance management) access to a Google account, in
// addition to the ADMIN_EMAIL env var bootstrap admin. See
// src/lib/instance.ts#isAdminEmail.
model AdminInvite {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Instance {
  id        String   @id @default(uuid())
  name      String
  // Shown in the header (e.g. "vpro"). Empty string for the default instance.
  label     String   @default("")
  // 稼働/停止. Members can only sign in to / operate an active instance.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  members    InstanceMember[]
  products   Product[]
  orders     Order[]
  editLogs   EditLog[]
  shifts     Shift[]
  shiftRoles ShiftRole[]
}

// Roles an Admin pre-registers per instance; the shift form picks from these.
// ShiftAssignment.role stores the name as plain text, so deleting a role here
// never rewrites existing shifts.
model ShiftRole {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  // Palette key from src/lib/shiftColors.ts; null = automatic (derived from
  // the name), so existing roles keep the colors they already had.
  color      String?
  createdAt  DateTime @default(now())

  @@unique([instanceId, name])
}

// A time slot (minute precision, stored in UTC; shown in JST). Only global
// Admins create/edit them. Who works it, and in which role, lives in
// ShiftAssignment.
model Shift {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime @default(now())

  assignments ShiftAssignment[]

  @@index([instanceId, startsAt])
  @@index([startsAt])
}

model ShiftAssignment {
  id               String         @id @default(uuid())
  shiftId          String
  shift            Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  memberId         String
  member           InstanceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Free-text role for this slot (e.g. レジ, 調理, 呼び込み).
  role             String
  // Set once the reminder was sent so the per-minute cron never repeats it.
  beforeNotifiedAt DateTime?
  startNotifiedAt  DateTime?

  @@index([shiftId])
  @@index([memberId])
}

model InstanceMember {
  id              String   @id @default(uuid())
  instanceId      String
  instance        Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  // The invited Google account email. This is the matching key so an
  // invite works even before that person has ever signed in.
  email           String
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Per-instance admin: can view this instance's edit history, in addition
  // to whatever the global Admin (ADMIN_EMAIL/AdminInvite) can already see.
  // Managed by a global Admin from /admin, same as invites.
  isInstanceAdmin Boolean  @default(false)
  // Admin-set override shown instead of the Google account name/email —
  // lets a member be labeled before they've ever signed in. Display
  // priority: displayName -> user.name (once signed in) -> email.
  displayName     String?
  createdAt       DateTime @default(now())

  shiftAssignments ShiftAssignment[]

  @@unique([instanceId, email])
}

// Audit trail for edits to orders/products — who changed what, when.
// Visible only to instance admins and global admins (src/lib/instance.ts).
model EditLog {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  entityType String // "ORDER" | "PRODUCT"
  entityId   String
  action     String // "EDIT" | "CANCEL" | "COMPLETE" | "DELETE"
  summary    String
  actorEmail String
  createdAt  DateTime @default(now())

  @@index([instanceId, createdAt])
}

model Product {
  id         String   @id @default(uuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name       String
  // Price in yen. 0 is allowed (used for inspection/検品 items).
  price      Int
  // Path under /uploads (own upload, picked default, or AI-generated).
  imageUrl   String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  orderItems OrderItem[]

  @@index([instanceId])
}

enum PaymentMethod {
  CASH // 現金/金券
  PAYPAY // PayPay
  D_PAYMENT // d払い
}

enum OrderStatus {
  WAITING
  COMPLETED
  CANCELLED
}

model Order {
  id            String        @id @default(uuid())
  instanceId    String
  instance      Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  // 客の特徴 (customer description, e.g. "赤い帽子")
  customerNote  String?
  paymentMethod PaymentMethod
  status        OrderStatus   @default(WAITING)
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  items OrderItem[]

  @@index([instanceId, status])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot of the product at order time, so CSV export/history stay
  // correct even if the product is later renamed, repriced, or deleted.
  productName String
  imageUrl    String?
  unitPrice   Int
  quantity    Int

  @@index([orderId])
}

// Last run of a background job triggered from outside (the shift-notification
// cron). Lets /admin show whether the external scheduler is really reaching us.
model JobRun {
  name    String   @id
  ranAt   DateTime
  checked Int      @default(0)
  sent    Int      @default(0)
}
